DB_HOST=localhost
# 55432, not 5432 — docker-compose.yml maps the container's Postgres to
# this host port instead of the default, since a natively-installed
# Postgres (common on Windows) binding 5432 first would otherwise shadow
# this container silently and produce a confusing password-auth error.
DB_PORT=55432
DB_USERNAME=arogya
DB_PASSWORD=arogya_dev_pw
DB_NAME=arogya

# Deploying to a hosted Postgres (Supabase, Render Postgres, etc.) instead
# of the local docker-compose one? Set DATABASE_URL to its connection
# string and the five DB_* vars above are ignored — see
# docs/step-11-cloud-deploy.md.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000

# Optional — real SMTP for notification emails. Leave all of these unset
# and the API falls back to a free, zero-signup Ethereal test inbox in
# dev (a preview link for each email is logged to the console and saved
# on the Notification row). Set these to use a real provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=notifications@yourdomain.com

# Payments (Razorpay) — sign up free at dashboard.razorpay.com, switch to
# "Test Mode" (top-left toggle), then Settings > API Keys > Generate Test
# Key. Payment order creation returns a clear 400 error until both are
# set — there's no keyless test mode the way email has Ethereal.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Prescription reading, the test finder, and AI report/health
# explanations — a genuinely free key, no card required, from
# aistudio.google.com/apikey. Returns a clear error until set.
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional automatic backups for the text AI features when Gemini is
# busy or down — each is used only if set. OpenRouter (free DeepSeek /
# Llama / Qwen models, no card: openrouter.ai/keys) and Groq (free, no
# card: console.groq.com/keys). Perplexity is paid (API credits).
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx

# "Sign in with Google" on the customer site. Not a secret — Google
# Identity Services hands back an ID token directly, no client secret
# involved. console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID > Web application. Must match
# VITE_GOOGLE_CLIENT_ID in apps/customer-web/.env.
# GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Mobile OTP sign-in via Firebase Phone Auth. Also not a secret — ID
# token verification only needs the public project id, checked against
# Google's own public keys (no service account file). Create a free
# project at console.firebase.google.com, enable Authentication >
# Sign-in method > Phone. Must match VITE_FIREBASE_PROJECT_ID in
# apps/customer-web/.env.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- WhatsApp: sign-in codes and booking messages ----
# Uses Meta's WhatsApp Business Cloud API directly (no SMS gateway, so no
# TRAI DLT registration). All of these are SECRETS/server-only — never put
# them in an app or in the web .env files.
#
# One-time setup at business.facebook.com / developers.facebook.com:
#   1. Create a Meta Business account and a WhatsApp Business Account, and
#      add + verify the business phone number that messages come from.
#      Copy the "Phone number ID".
#   2. Create an AUTHENTICATION message template (category Authentication,
#      with the Copy code button) and get it approved. Its name is
#      WHATSAPP_OTP_TEMPLATE. Meta writes the wording ("<code> is your
#      verification code ...").
#   3. Create a System User in Business settings, give it the WhatsApp
#      account, and generate a PERMANENT access token with the
#      whatsapp_business_messaging permission (the temporary one expires
#      in 24 hours).
#
# Switch sign-in codes from Firebase to WhatsApp (needs all four lines
# below; if any is missing the site keeps using Firebase):
# OTP_PROVIDER=whatsapp
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_OTP_TEMPLATE=arogya_otp
# Optional (defaults shown):
# WHATSAPP_TEMPLATE_LANG=en        # language code the templates were approved in
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_OTP_EXPIRY_MINUTES=10
# OTP_MAX_PER_PHONE_HOUR=5         # codes per number per hour (30s apart)
# OTP_MAX_PER_IP_HOUR=20
# OTP_MAX_PER_HOUR=300             # whole server — a cost safety stop
# (5 wrong guesses kill a code.)
#
# Booking messages (uses the access token and phone number above). Each is
# sent only if its UTILITY template is set; the body variables are
# {{1}} = first name, then the ones listed:
# WHATSAPP_TPL_BOOKING_CREATED=   # {{2}} date/time, {{3}} booking no.
# WHATSAPP_TPL_PREP_REMINDER=     # {{2}} date/time
# WHATSAPP_TPL_REPORT_READY=      # {{2}} booking no.

# ---- Push notifications to the Android app (Firebase Cloud Messaging) ----
# The Google service-account key lets this server send pushes. Firebase
# console > Project settings > Service accounts > Generate new private
# key. Paste the whole JSON (or its base64) here; it is a SECRET and must
# never be in the app. Without it, push is simply off.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Passkeys: fingerprint / face-lock sign-in ----
# Customers verify their number once (OTP or Google), then sign in with a
# passkey. Passkeys are tied to the website's domain, so list every site
# origin customers sign in from (comma-separated, no trailing slash).
# Default: https://arogya-customer-web.onrender.com,http://localhost:5173
# WEBAUTHN_ORIGINS=https://arogya-customer-web.onrender.com,http://localhost:5173
# Inside the Android app the phone reports the app as the origin. Default
# is the hash of the standard React Native key the GitHub APK build uses.
# WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:-sYXRdwJA3hvue3mKpYrOZ9zSPC7b4mbgzJmdZEDO5w
