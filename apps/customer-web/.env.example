VITE_API_URL=http://localhost:3000

# Placeholder — set to a real support number (E.164, e.g. +911234567890)
# before the "Book via Call"/"Book via WhatsApp" tiles go live.
VITE_SUPPORT_PHONE=+910000000000

# "Sign in with Google" and mobile OTP on the login page — both optional.
# Leave all four blank and the login page works exactly as before (phone
# + password only). Each value here must match the matching one in
# apps/api/.env (GOOGLE_CLIENT_ID / FIREBASE_PROJECT_ID) — see that file
# for where to get them; none of these four is a secret.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
