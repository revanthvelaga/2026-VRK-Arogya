<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Lets the person grant "Usage access" so Arogya can show minutes per app. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

  <!-- Keeps the 15-minute charging check scheduled after a restart. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <service
      android:name=".ChargeCheckJob"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />

    <!-- Counts reels / shorts swiped in a few social apps. Only runs once the
         person turns it on in Android's accessibility settings. -->
    <service
      android:name=".ReelCounterService"
      android:exported="true"
      android:label="Arogya reel counter"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/arogya_reel_counter" />
    </service>
  </application>
</manifest>
